# Postgres connection string
DATABASE_URL=postgres://sbom:sbom@localhost:5432/sbom
# Optional comma-separated bearer tokens required for SBOM uploads. Empty = open uploads in development only.
UPLOAD_TOKENS=
# In production, uploads are rejected when UPLOAD_TOKENS is empty unless this is true.
ALLOW_OPEN_UPLOADS=false
# Owner-only sign-in (GitHub OAuth). All five must be set to gate reads; see README. In production, reads return 503 without them
# unless ALLOW_OPEN_READS=true.
OWNER_GITHUB_ID=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOW_OPEN_READS=false

# Worker settings
WORKER_POLL_SECONDS=21600
VULN_TTL_HOURS=12
LATEST_TTL_HOURS=24
SCORECARD_TTL_HOURS=168
ABANDONED_AFTER_YEARS=2
KEV_TTL_HOURS=24
EPSS_TTL_HOURS=24

# Write rate limit (uploads and deletes) per client per window; 0 disables. Set TRUST_PROXY=true only behind a proxy that sets X-Forwarded-For.
WRITE_RATE_LIMIT=60
WRITE_RATE_WINDOW_SECONDS=60
# Separate per-client budget for /api/auth/*; 0 disables.
AUTH_RATE_LIMIT=60
TRUST_PROXY=false
